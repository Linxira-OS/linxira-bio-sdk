    "inputs": [
      {
        "role": "expression-matrix",
        "formats": [
          "csv",
          "tsv"
        ]
      },
      {
        "role": "sample-metadata",
        "formats": [
          "csv",
          "tsv"
        ]
      }
    ],
    "outputs": {
      "roles": [
        "corrected-expression"
      ],
      "kind": "domain-file",
      "formats": [
        "tsv"
      ],
      "media_type": "text/tab-separated-values"
    },
    "parameters": [
      "output_directory",
      "output_filename",
      "batch_column",
      "method"
    ]
  },
  "input_schema": {
    "type": "object",
    "$ref": "schemas/input.schema.json"
  },
  "output_schema": {
    "type": "object",
    "$ref": "schemas/output.schema.json"
  },
  "platforms": [
    "windows-gnu",
    "debian",
    "arch"
  ],
  "network": {
    "access": "none",
    "allowed_hosts": []
  },
  "resources": {
    "minimum_memory_mb": 1024,
    "minimum_disk_mb": 1024,
    "recommended_threads": 1,
    "gpu": "none"
  },
