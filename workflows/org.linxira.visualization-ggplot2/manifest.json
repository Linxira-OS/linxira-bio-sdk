  "output_schema": {
    "type": "object",
    "$ref": "schemas/output.schema.json"
  },
  "platforms": [
    "windows-gnu",
    "debian",
    "arch"
  ],
  "network": {
    "access": "none",
    "allowed_hosts": []
  },
  "resources": {
    "minimum_memory_mb": 256,
    "minimum_disk_mb": 100,
    "recommended_threads": 1,
    "gpu": "none"
  },
  "contract": {
    "inputs": [
      {
        "role": "plot-spec",
        "formats": [
          "json"
        ]
      }
    ],
    "outputs": {
      "roles": [
        "figure"
      ],
      "kind": "plot",
      "formats": [
        "svg",
        "png",
        "pdf"
      ],
      "media_type": "image/*"
    },
    "parameters": [
      "output_path",
      "title",
      "subtitle",
      "x_label",
      "y_label",
      "x_range",
      "y_range",
      "x_log",
      "y_log",
      "grid",
      "theme",
      "palette",
      "legend",
      "figure.width",
      "figure.height",
      "figure.dpi",
      "font.family",
      "font.size",
      "output.format"
    ]
  },
