{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/bio/ssr.v1.json",
  "title": "Linxira Bio simple sequence repeat summary",
  "type": "object",
  "required": [
    "sequence_count",
    "total_bases",
    "ssr_count",
    "compound_group_count",
    "motif_length_counts",
    "sequences"
  ],
  "properties": {
    "sequence_count": {"type": "integer", "minimum": 0},
    "total_bases": {"type": "integer", "minimum": 0},
    "ssr_count": {"type": "integer", "minimum": 0},
    "compound_group_count": {"type": "integer", "minimum": 0},
    "motif_length_counts": {
      "type": "object",
      "propertyNames": {"pattern": "^[1-6]$"},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "sequences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sequence_id", "length", "ssr_count"],
        "properties": {
          "sequence_id": {"type": "string", "minLength": 1},
          "length": {"type": "integer", "minimum": 0},
          "ssr_count": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
