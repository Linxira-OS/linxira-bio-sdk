{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/bio/annotation-gxf-to-bed.v1.json",
  "title": "Linxira Bio GFF3/GTF to BED conversion result",
  "type": "object",
  "required": ["input_record_count", "output_record_count", "skipped_no_id_count", "feature_types", "warnings"],
  "properties": {
    "input_record_count": {"type": "integer", "minimum": 0, "maximum": 2000000},
    "output_record_count": {"type": "integer", "minimum": 0, "maximum": 2000000},
    "skipped_no_id_count": {"type": "integer", "minimum": 0, "maximum": 2000000},
    "feature_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}