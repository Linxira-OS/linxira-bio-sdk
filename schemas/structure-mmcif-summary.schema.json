{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/bio/structure-mmcif-summary.v1.json",
  "title": "Linxira Bio mmCIF structure summary result",
  "type": "object",
  "required": ["format", "coordinate_units", "model_count", "chain_count", "residue_count", "atom_count", "polymer_atom_count", "hetero_atom_count", "element_counts", "bounds", "models", "warnings"],
  "properties": {
    "format": {"const": "mmcif"},
    "coordinate_units": {"const": "angstrom"},
    "model_count": {"type": "integer", "minimum": 1},
    "chain_count": {"type": "integer", "minimum": 1},
    "residue_count": {"type": "integer", "minimum": 1},
    "atom_count": {"type": "integer", "minimum": 1, "maximum": 100000},
    "polymer_atom_count": {"type": "integer", "minimum": 0},
    "hetero_atom_count": {"type": "integer", "minimum": 0},
    "element_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "bounds": {"$ref": "#/$defs/bounds"},
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}},
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": ["minimum", "maximum", "span", "center"],
      "properties": {"minimum": {"$ref": "#/$defs/point"}, "maximum": {"$ref": "#/$defs/point"}, "span": {"$ref": "#/$defs/point"}, "center": {"$ref": "#/$defs/point"}},
      "additionalProperties": false
    },
    "chain": {
      "type": "object",
      "required": ["chain_id", "atom_count", "residue_count", "polymer_residue_count", "hetero_residue_count"],
      "properties": {
        "chain_id": {"type": "string"},
        "atom_count": {"type": "integer", "minimum": 1},
        "residue_count": {"type": "integer", "minimum": 1},
        "polymer_residue_count": {"type": "integer", "minimum": 0},
        "hetero_residue_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["model_id", "atom_count", "residue_count", "chains"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "atom_count": {"type": "integer", "minimum": 1},
        "residue_count": {"type": "integer", "minimum": 1},
        "chains": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/chain"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
