{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/bio/interval-intersect.v1.json",
  "title": "Linxira Bio BED interval intersection result",
  "type": "object",
  "required": [
    "left_interval_count", "right_interval_count", "overlap_pair_count",
    "left_overlapped_count", "right_overlapped_count",
    "total_overlap_bases", "contigs", "warnings"
  ],
  "properties": {
    "left_interval_count": { "$ref": "#/$defs/count" },
    "right_interval_count": { "$ref": "#/$defs/count" },
    "overlap_pair_count": { "$ref": "#/$defs/count" },
    "left_overlapped_count": { "$ref": "#/$defs/count" },
    "right_overlapped_count": { "$ref": "#/$defs/count" },
    "total_overlap_bases": { "$ref": "#/$defs/count" },
    "contigs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/contig" }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "contig": {
      "type": "object",
      "required": [
        "left_interval_count", "right_interval_count", "overlap_pair_count",
        "left_overlapped_count", "right_overlapped_count", "total_overlap_bases"
      ],
      "properties": {
        "left_interval_count": { "$ref": "#/$defs/count" },
        "right_interval_count": { "$ref": "#/$defs/count" },
        "overlap_pair_count": { "$ref": "#/$defs/count" },
        "left_overlapped_count": { "$ref": "#/$defs/count" },
        "right_overlapped_count": { "$ref": "#/$defs/count" },
        "total_overlap_bases": { "$ref": "#/$defs/count" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
