{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/bio/phylogeny-tree-transform.v1.json",
  "title": "Linxira Bio phylogeny tree transform result",
  "type": "object",
  "required": ["leaf_count", "internal_node_count", "max_depth", "total_branch_length", "rerooted", "relabeled_count", "output", "warnings"],
  "properties": {
    "leaf_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "internal_node_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "max_depth": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "total_branch_length": {"type": ["number", "null"], "minimum": 0},
    "rerooted": {"type": "boolean"},
    "relabeled_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "output": {"type": "string", "minLength": 1},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
