{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/bio/protein-properties.v1.json",
  "title": "Linxira Bio protein physicochemical properties result",
  "type": "object",
  "required": ["sequence_count", "total_residues", "records", "warnings"],
  "properties": {
    "sequence_count": {"type": "integer", "minimum": 1},
    "total_residues": {"type": "integer", "minimum": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "length", "standard_residue_count", "ambiguous_residue_count", "composition", "molecular_weight_da", "isoelectric_point", "charge_at_ph7", "aromaticity_percent", "gravy", "extinction_coefficient_reduced", "extinction_coefficient_oxidized"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": ["string", "null"]},
          "length": {"type": "integer", "minimum": 1},
          "standard_residue_count": {"type": "integer", "minimum": 0},
          "ambiguous_residue_count": {"type": "integer", "minimum": 0},
          "composition": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
          "molecular_weight_da": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "isoelectric_point": {"type": ["number", "null"], "minimum": 0, "maximum": 14},
          "charge_at_ph7": {"type": ["number", "null"]},
          "aromaticity_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "gravy": {"type": ["number", "null"]},
          "extinction_coefficient_reduced": {"type": ["integer", "null"], "minimum": 0},
          "extinction_coefficient_oxidized": {"type": ["integer", "null"], "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
