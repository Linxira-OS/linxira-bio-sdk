{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/workflows/org.linxira.batch-combat-py/output.v1.json",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "capability",
    "status",
    "result",
    "artifacts",
    "provenance",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "const": "expression.batch-correct.v1"
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "method": {
          "const": "combat-parametric"
        },
        "feature_count": {
          "type": "integer",
          "minimum": 0
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "batch_count": {
          "type": "integer",
          "minimum": 2
        },
        "batch_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 2
          }
        },
        "covariate_columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "eb_iterations_max": {
          "type": "integer",
          "minimum": 1
        },
        "eb_priors": {
          "type": "object",
          "required": [
            "gamma_bar",
            "tau_squared",
            "a_prior",
            "b_prior"
          ],
          "properties": {
            "gamma_bar": {
              "type": "object"
            },
            "tau_squared": {
              "type": "object"
            },
            "a_prior": {
              "type": "object"
            },
            "b_prior": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "role",
          "kind",
          "path",
          "format",
          "media_type",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "artifact_id": {
            "const": "corrected-matrix"
          },
          "role": {
            "const": "corrected-expression"
          },
          "kind": {
            "const": "domain-file"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "const": "tsv"
          },
          "media_type": {
            "const": "text/tab-separated-values"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "artifacts": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
