{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/workflows/medical-survival/input.v1.json",
  "type": "object",
  "required": ["schema_version", "job_id", "capability", "inputs", "execution", "parameters"],
  "properties": {
    "schema_version": { "const": "2" },
    "job_id": { "type": "string", "minLength": 1 },
    "capability": { "const": "medical.survival.v1" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/inputArtifact" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": { "role": { "const": "cohort" } }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "execution": {
      "type": "object",
      "required": ["mode"],
      "properties": { "mode": { "const": "local-cpu" } },
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "required": [
        "output_directory", "time_column", "event_column", "group_column", "reference_level"
      ],
      "properties": {
        "output_directory": { "type": "string", "minLength": 1 },
        "time_column": { "type": "string", "minLength": 1 },
        "event_column": { "type": "string", "minLength": 1 },
        "group_column": { "type": "string", "minLength": 1 },
        "reference_level": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "inputArtifact": {
      "type": "object",
      "required": ["artifact_id", "role", "cardinality", "files"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "role": { "const": "cohort" },
        "cardinality": { "const": "single" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["file_id", "path", "format", "compression", "size_bytes"],
            "properties": {
              "file_id": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "format": { "enum": ["csv", "tsv"] },
              "compression": { "const": "none" },
              "size_bytes": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
