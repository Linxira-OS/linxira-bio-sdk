{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/workflows/org.linxira.batch-combat-r/input.v1.json",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "capability",
    "inputs",
    "execution",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "2"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "const": "expression.batch-correct.v1"
    },
    "inputs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/inputArtifact"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "expression-matrix"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "sample-metadata"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "execution": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "local-cpu"
        }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "required": [
        "output_directory",
        "output_filename"
      ],
      "properties": {
        "output_directory": {
          "type": "string",
          "minLength": 1
        },
        "output_filename": {
          "type": "string",
          "minLength": 1
        },
        "batch_column": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "const": "combat"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "inputArtifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "role",
        "cardinality",
        "files"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "expression-matrix",
            "sample-metadata"
          ]
        },
        "cardinality": {
          "const": "single"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "file_id",
              "path",
              "format",
              "compression",
              "size_bytes"
            ],
            "properties": {
              "file_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "enum": [
                  "csv",
                  "tsv"
                ]
              },
              "compression": {
                "const": "none"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
