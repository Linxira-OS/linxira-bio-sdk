{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/bio/window-depth.v1.json",
  "title": "Linxira Bio fixed-window depth analysis result",
  "type": "object",
  "required": [
    "tool",
    "mode",
    "output_path",
    "output_bytes",
    "thread_count",
    "command_count",
    "warnings",
    "summary"
  ],
  "properties": {
    "tool": {"enum": ["samtools"]},
    "mode": {"enum": ["window-depth"]},
    "output_path": {"type": "string", "minLength": 1},
    "output_bytes": {"type": "integer", "minimum": 0},
    "thread_count": {"type": "integer", "minimum": 1, "maximum": 1024},
    "command_count": {"enum": [1]},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "summary": {
      "type": "object",
      "required": [
        "window_size",
        "reference_count",
        "window_count",
        "total_bases",
        "covered_bases",
        "breadth_percent",
        "mean_depth",
        "max_depth",
        "references"
      ],
      "properties": {
        "window_size": {"type": "integer", "minimum": 1},
        "reference_count": {"type": "integer", "minimum": 0},
        "window_count": {"type": "integer", "minimum": 0},
        "total_bases": {"type": "integer", "minimum": 0},
        "covered_bases": {"type": "integer", "minimum": 0},
        "breadth_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "mean_depth": {"type": ["number", "null"], "minimum": 0},
        "max_depth": {"type": "integer", "minimum": 0},
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "reference",
              "length",
              "window_count",
              "covered_bases",
              "breadth_percent",
              "mean_depth",
              "max_depth"
            ],
            "properties": {
              "reference": {"type": "string", "minLength": 1},
              "length": {"type": "integer", "minimum": 1},
              "window_count": {"type": "integer", "minimum": 1},
              "covered_bases": {"type": "integer", "minimum": 0},
              "breadth_percent": {"type": "number", "minimum": 0, "maximum": 100},
              "mean_depth": {"type": "number", "minimum": 0},
              "max_depth": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
