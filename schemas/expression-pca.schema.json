{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/bio/expression-pca.v1.json",
  "title": "Linxira Bio expression PCA result",
  "type": "object",
  "required": ["feature_count", "sample_count", "scaled_features", "total_variance", "components", "samples", "warnings"],
  "properties": {
    "feature_count": {"type": "integer", "minimum": 1},
    "sample_count": {"type": "integer", "minimum": 2},
    "scaled_features": {"type": "boolean"},
    "total_variance": {"type": "number", "exclusiveMinimum": 0},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component", "eigenvalue", "explained_variance_percent", "top_positive_loadings", "top_negative_loadings"],
        "properties": {
          "component": {"type": "integer", "minimum": 1},
          "eigenvalue": {"type": "number", "exclusiveMinimum": 0},
          "explained_variance_percent": {"type": "number", "minimum": 0, "maximum": 100},
          "top_positive_loadings": {"$ref": "#/$defs/loadings"},
          "top_negative_loadings": {"$ref": "#/$defs/loadings"}
        },
        "additionalProperties": false
      }
    },
    "samples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["sample", "scores"],
        "properties": {
          "sample": {"type": "string", "minLength": 1},
          "scores": {"type": "array", "minItems": 1, "items": {"type": "number"}}
        },
        "additionalProperties": false
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "loadings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature", "loading"],
        "properties": {
          "feature": {"type": "string", "minLength": 1},
          "loading": {"type": "number"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
