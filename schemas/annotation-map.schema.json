{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/bio/annotation-map.v1.json",
  "title": "Linxira Bio normalized functional annotation map",
  "type": "object",
  "required": ["input_row_count", "gene_count", "term_count", "association_count", "output_path", "associations", "warnings"],
  "properties": {
    "input_row_count": {"type": "integer", "minimum": 1},
    "gene_count": {"type": "integer", "minimum": 1},
    "term_count": {"type": "integer", "minimum": 1},
    "association_count": {"type": "integer", "minimum": 1},
    "output_path": {"type": "string", "minLength": 1},
    "associations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/association"}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "association": {
      "type": "object",
      "required": ["gene_id", "term_id", "term_name", "namespace"],
      "properties": {
        "gene_id": {"type": "string", "minLength": 1},
        "term_id": {"type": "string", "minLength": 1},
        "term_name": {"type": ["string", "null"]},
        "namespace": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
