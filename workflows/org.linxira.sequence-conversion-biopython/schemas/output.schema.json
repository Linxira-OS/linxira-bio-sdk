{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/workflows/sequence-conversion-biopython/output.v1.json",
  "type": "object",
  "required": ["schema_version", "job_id", "capability", "status", "result", "artifacts", "provenance", "diagnostics"],
  "properties": {
    "schema_version": { "const": "2" },
    "job_id": { "type": "string", "minLength": 1 },
    "capability": { "const": "sequence.convert.biopython.v1" },
    "status": { "enum": ["ok", "error"] },
    "result": {
      "type": "object",
      "properties": {
        "records_written": { "type": "integer", "minimum": 0 },
        "input_format": { "enum": ["fasta", "fastq", "genbank", "embl"] },
        "output_format": { "enum": ["fasta", "fastq", "genbank", "embl"] }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "role", "kind", "path", "format", "size_bytes", "sha256"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "kind": { "const": "domain-file" },
          "path": { "type": "string", "minLength": 1 },
          "format": { "enum": ["fasta", "fastq", "genbank", "embl"] },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "provenance": { "type": "object" },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["info", "warning", "error"] },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } }, "required": ["status"] },
      "then": {
        "properties": {
          "result": {
            "required": ["records_written", "input_format", "output_format"]
          },
          "artifacts": { "minItems": 1, "maxItems": 1 },
          "diagnostics": { "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "result": { "maxProperties": 0 },
          "artifacts": { "maxItems": 0 },
          "diagnostics": { "minItems": 1 }
        }
      }
    }
  ],
  "additionalProperties": false
}
