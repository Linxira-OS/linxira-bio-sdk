{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/workflows/bulk-expression-deseq2/input.v1.json",
  "type": "object",
  "required": ["schema_version", "job_id", "capability", "inputs", "execution", "parameters"],
  "properties": {
    "schema_version": { "const": "2" },
    "job_id": { "type": "string", "minLength": 1 },
    "capability": {
      "enum": [
        "expression.differential.v1",
        "medical.bulk-rnaseq.v1",
        "expression.deseq2.v1"
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/inputArtifact" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": { "role": { "const": "counts" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": { "role": { "const": "sample_metadata" } }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "execution": {
      "type": "object",
      "required": ["mode"],
      "properties": { "mode": { "const": "local-cpu" } },
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "required": [
        "output_directory", "feature_id_column", "sample_id_column", "condition_column",
        "reference_level", "contrast_level"
      ],
      "properties": {
        "output_directory": { "type": "string", "minLength": 1 },
        "feature_id_column": { "type": "string", "minLength": 1 },
        "sample_id_column": { "type": "string", "minLength": 1 },
        "condition_column": { "type": "string", "minLength": 1 },
        "reference_level": { "type": "string", "minLength": 1 },
        "contrast_level": { "type": "string", "minLength": 1 },
        "alpha": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.05 },
        "min_total_count": { "type": "integer", "minimum": 0, "default": 10 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "inputArtifact": {
      "type": "object",
      "required": ["artifact_id", "role", "cardinality", "files"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["counts", "sample_metadata"] },
        "cardinality": { "const": "single" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["file_id", "path", "format", "compression", "size_bytes"],
            "properties": {
              "file_id": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "format": { "enum": ["csv", "tsv"] },
              "compression": { "const": "none" },
              "size_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740992 },
              "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
