    {
      "id": "phylogenetics",
      "description": "Local maximum-likelihood phylogenetic inference",
      "tools": ["iqtree"]
    },
    {
      "id": "motif-analysis",
      "description": "Local de novo sequence motif discovery",
      "tools": ["meme"]
    },
    {
      "id": "protein-structure",
      "description": "Local coordinate-derived protein structure annotation",
      "tools": ["mkdssp"]
    },
    {
      "id": "genomics-cli",
      "description": "Common alignment, variant, interval, and mapping tools",
      "tools": ["samtools", "bcftools", "bedtools", "minimap2"]
