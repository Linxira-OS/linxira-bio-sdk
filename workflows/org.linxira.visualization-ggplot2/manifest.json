  "entrypoint": {
    "path": "src/render.R",
    "arguments": [
      "--request",
      "{request}",
      "--result",
      "{result}"
    ]
  },
  "runtime": {
    "kind": "r",
    "version": "4.6.1",
    "core_compatibility": ">=0.1.0,<2.0.0",
    "dependency_lock": {
