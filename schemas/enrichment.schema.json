{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/bio/enrichment.v1.json",
  "title": "Linxira Bio over-representation analysis result",
  "type": "object",
  "required": ["analysis_type", "query_input_count", "query_mapped_count", "query_unmapped_count", "background_gene_count", "tested_term_count", "reported_term_count", "omitted_term_count", "terms", "warnings"],
  "properties": {
    "analysis_type": {"enum": ["custom", "go", "kegg"]},
    "query_input_count": {"type": "integer", "minimum": 1},
    "query_mapped_count": {"type": "integer", "minimum": 1},
    "query_unmapped_count": {"type": "integer", "minimum": 0},
    "background_gene_count": {"type": "integer", "minimum": 1},
    "tested_term_count": {"type": "integer", "minimum": 1},
    "reported_term_count": {"type": "integer", "minimum": 1},
    "omitted_term_count": {"type": "integer", "minimum": 0},
    "terms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/term"}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "term": {
      "type": "object",
      "required": ["term_id", "term_name", "namespace", "overlap_count", "query_gene_count", "background_term_count", "background_gene_count", "fold_enrichment", "p_value", "adjusted_p_value", "overlap_genes"],
      "properties": {
        "term_id": {"type": "string", "minLength": 1},
        "term_name": {"type": ["string", "null"]},
        "namespace": {"type": ["string", "null"]},
        "overlap_count": {"type": "integer", "minimum": 1},
        "query_gene_count": {"type": "integer", "minimum": 1},
        "background_term_count": {"type": "integer", "minimum": 1},
        "background_gene_count": {"type": "integer", "minimum": 1},
        "fold_enrichment": {"type": "number", "exclusiveMinimum": 0},
        "p_value": {"type": "number", "minimum": 0, "maximum": 1},
        "adjusted_p_value": {"type": "number", "minimum": 0, "maximum": 1},
        "overlap_genes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
