{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/bio/blast-parse.v1.json",
  "title": "Linxira Bio BLAST result parse",
  "type": "object",
  "required": ["format", "record_count", "query_count", "subject_count", "min_evalue", "max_bit_score", "mean_identity_percent", "hits", "warnings"],
  "properties": {
    "format": {"enum": ["blast-tabular-outfmt6", "blast-tabular-outfmt7", "blast-xml1"]},
    "record_count": {"type": "integer", "minimum": 0, "maximum": 2000000},
    "query_count": {"type": "integer", "minimum": 0, "maximum": 2000000},
    "subject_count": {"type": "integer", "minimum": 0, "maximum": 2000000},
    "min_evalue": {"type": ["number", "null"], "minimum": 0},
    "max_bit_score": {"type": ["number", "null"]},
    "mean_identity_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "hits": {"type": "array", "maxItems": 2000000, "items": {"$ref": "#/$defs/hit"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "hit": {
      "type": "object",
      "required": ["query_id", "subject_id", "percent_identity", "alignment_length", "mismatch_count", "gap_open_count", "query_start", "query_end", "subject_start", "subject_end", "evalue", "bit_score"],
      "properties": {
        "query_id": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "percent_identity": {"type": "number", "minimum": 0, "maximum": 100},
        "alignment_length": {"type": "integer", "minimum": 1},
        "mismatch_count": {"type": ["integer", "null"], "minimum": 0},
        "gap_open_count": {"type": ["integer", "null"], "minimum": 0},
        "query_start": {"type": "integer", "minimum": 1},
        "query_end": {"type": "integer", "minimum": 1},
        "subject_start": {"type": "integer", "minimum": 1},
        "subject_end": {"type": "integer", "minimum": 1},
        "evalue": {"type": "number", "minimum": 0},
        "bit_score": {"type": "number"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
