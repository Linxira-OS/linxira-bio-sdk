{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/workflows/expression-wgcna/output.v1.json",
  "type": "object",
  "required": ["schema_version", "job_id", "capability", "status", "result", "artifacts", "provenance", "diagnostics"],
  "properties": {
    "schema_version": { "const": "2" },
    "job_id": { "type": "string", "minLength": 1 },
    "capability": {
      "enum": ["expression.wgcna.v1"]
    },
    "status": { "enum": ["ok", "error"] },
    "result": {
      "type": "object",
      "required": [
        "input_genes", "analyzed_genes", "filtered_genes", "samples",
        "total_modules", "best_power", "min_module_size", "merge_cut_height",
        "network_type", "log_transform", "effective_parameters"
      ],
      "properties": {
        "input_genes": { "type": "integer", "minimum": 0 },
        "analyzed_genes": { "type": "integer", "minimum": 0 },
        "filtered_genes": { "type": "integer", "minimum": 0 },
        "samples": { "type": "integer", "minimum": 0 },
        "total_modules": { "type": "integer", "minimum": 0 },
        "best_power": { "type": "integer", "minimum": 0 },
        "min_module_size": { "type": "integer", "minimum": 0 },
        "merge_cut_height": { "type": "number", "minimum": 0, "maximum": 1 },
        "network_type": { "enum": ["unsigned", "signed", "signed hybrid"] },
        "log_transform": { "type": "boolean" },
        "effective_parameters": { "type": "object" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["artifact_id", "role", "kind", "path", "format", "media_type", "size_bytes", "sha256"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["module-assignments", "module-eigengenes", "module-summary", "scale-free-fit"] },
          "kind": { "const": "table" },
          "path": { "type": "string", "minLength": 1 },
          "format": { "const": "csv" },
          "media_type": { "const": "text/csv" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "provenance": { "type": "object" },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["info", "warning", "error"] },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "ok" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "diagnostics": {
            "contains": {
              "type": "object",
              "required": ["severity"],
              "properties": { "severity": { "const": "error" } }
            },
            "maxContains": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "error" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "result": { "type": "object", "maxProperties": 0 },
          "artifacts": { "maxItems": 0 },
          "diagnostics": {
            "contains": {
              "type": "object",
              "required": ["severity"],
              "properties": { "severity": { "const": "error" } }
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
