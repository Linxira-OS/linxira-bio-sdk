  "entrypoint": {
    "path": "src/render.py",
    "arguments": [
      "--request",
      "{request}",
      "--result",
      "{result}"
    ]
  },
  "runtime": {
    "kind": "python",
    "version": "3.12.x",
    "core_compatibility": ">=0.1.0,<2.0.0",
    "dependency_lock": {
      "path": "requirements.lock",
      "sha256": "3ea838f643058e7d9aab754b1688ce087f04fbbc429900fed849e8dd5c1bfd16"
    }
  },
  "input_schema": {
    "type": "object",
