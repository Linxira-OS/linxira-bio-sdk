{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/workflows/chemistry-descriptors-rdkit/output.v1.json",
  "type": "object",
  "required": ["schema_version", "job_id", "capability", "status", "result", "artifacts", "provenance", "diagnostics"],
  "properties": {
    "schema_version": { "const": "2" },
    "job_id": { "type": "string", "minLength": 1 },
    "capability": { "const": "chemistry.descriptors.v1" },
    "status": { "enum": ["ok", "error"] },
    "result": {
      "type": "object",
      "properties": {
        "molecule_count": { "type": "integer", "minimum": 0 },
        "descriptor_names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rows": { "type": "array" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "role", "kind", "path", "format", "media_type", "size_bytes", "sha256"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "role": { "const": "descriptors" },
          "kind": { "const": "table" },
          "path": { "type": "string", "minLength": 1 },
          "format": { "const": "tsv" },
          "media_type": { "const": "text/tab-separated-values" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "provenance": { "type": "object" },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["info", "warning", "error"] },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } }, "required": ["status"] },
      "then": {
        "properties": {
          "artifacts": { "minItems": 1, "maxItems": 1 }
        }
      }
    }
  ],
  "additionalProperties": false
}
