{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/bio/simulate-cell.v1.json",
  "title": "Linxira Bio mechanistic cell lineage simulation summary",
  "type": "object",
  "required": [
    "seed",
    "model_source",
    "model",
    "end_time",
    "bins",
    "event_count",
    "transcription_events",
    "translation_events",
    "division_count",
    "lineage_depth",
    "initial_substrate",
    "final_substrate",
    "final_biomass",
    "mean_generation_time",
    "per_gene"
  ],
  "properties": {
    "seed": {"type": "integer", "minimum": 0},
    "model_source": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "required": [
        "monod_constant",
        "substrate_initial",
        "division_biomass",
        "genes"
      ],
      "properties": {
        "monod_constant": {"type": "number", "minimum": 0},
        "substrate_initial": {"type": "integer", "minimum": 0},
        "division_biomass": {"type": "number", "exclusiveMinimum": 0},
        "genes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kon",
              "koff",
              "ks",
              "kdm",
              "ktl",
              "kdp",
              "yield_per_protein"
            ],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "kon": {"type": "number", "minimum": 0},
              "koff": {"type": "number", "minimum": 0},
              "ks": {"type": "number", "minimum": 0},
              "kdm": {"type": "number", "minimum": 0},
              "ktl": {"type": "number", "minimum": 0},
              "kdp": {"type": "number", "minimum": 0},
              "yield_per_protein": {"type": "number", "minimum": 0}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "end_time": {"type": "number", "exclusiveMinimum": 0},
    "bins": {"type": "integer", "minimum": 1},
    "event_count": {"type": "integer", "minimum": 0},
    "transcription_events": {"type": "integer", "minimum": 0},
    "translation_events": {"type": "integer", "minimum": 0},
    "division_count": {"type": "integer", "minimum": 0},
    "lineage_depth": {"type": "integer", "minimum": 0},
    "initial_substrate": {"type": "integer", "minimum": 0},
    "final_substrate": {"type": "integer", "minimum": 0},
    "final_biomass": {"type": "number", "minimum": 0},
    "mean_generation_time": {"type": "number", "minimum": 0},
    "per_gene": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "mean_mrna",
          "mean_protein",
          "final_mrna",
          "final_protein",
          "transcription_events",
          "translation_events"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "mean_mrna": {"type": "number", "minimum": 0},
          "mean_protein": {"type": "number", "minimum": 0},
          "final_mrna": {"type": "integer", "minimum": 0},
          "final_protein": {"type": "integer", "minimum": 0},
          "transcription_events": {"type": "integer", "minimum": 0},
          "translation_events": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
