  },
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/Linxira-OS/linxira-bio-sdk",
  "entrypoint": {
    "path": "src/render.R",
    "arguments": [
      "--request",
      "{request}",
      "--result",
      "{result}"
    ]
  },
  "runtime": {
    "kind": "r",
    "version": ">=4.4.0,<5.0.0",
    "core_compatibility": ">=0.1.0,<2.0.0",
    "dependency_lock": {
      "path": "dependencies.lock.json",
      "sha256": "e3dd638f605c06395f7dc76e651cce8a657c115270af6e2a5b26b1bcf596c149"
    }
  },
  "input_schema": {
    "type": "object",
    "$ref": "schemas/input.schema.json"
  },
  "output_schema": {
    "type": "object",
    "$ref": "schemas/output.schema.json"
  },
  "platforms": [
    "windows-gnu",
    "debian",
    "arch"
  ],
  "network": {
    "access": "none",
    "allowed_hosts": []
  },
  "resources": {
    "minimum_memory_mb": 256,
    "minimum_disk_mb": 100,
    "recommended_threads": 1,
    "gpu": "none"
  },
  "contract": {
    "inputs": [
      {
        "role": "plot-spec",
        "formats": [
          "json"
        ]
      }
    ],
    "outputs": {
      "roles": [
        "figure"
      ],
      "kind": "plot",
      "formats": [
        "svg",
        "png",
        "pdf"
      ],
      "media_type": "image/*"
    },
    "parameters": [
      "output_path",
      "title",
      "subtitle",
      "x_label",
      "y_label",
      "x_range",
      "y_range",
      "x_log",
      "y_log",
      "grid",
      "theme",
      "palette",
      "legend",
      "figure.width",
      "figure.height",
      "figure.dpi",
      "font.family",
      "font.size",
      "output.format"
    ]
  },
  "files": [
