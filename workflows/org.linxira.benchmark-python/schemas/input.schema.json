{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://linxira.org/schemas/workflows/benchmark-python/input.v1.json",
 "title": "Request accepted by the Python benchmark harness",
 "description": "A worker V2 request whose execution.backend selects the Python implementation. Input roles and parameters are those of the native capability; the worker injects parameters.output_directory.",
 "type": "object",
 "required": [
  "schema_version",
  "job_id",
  "capability",
  "inputs",
  "execution",
  "parameters"
 ],
 "properties": {
  "schema_version": {
   "const": "2"
  },
  "job_id": {
   "type": "string",
   "minLength": 1
  },
  "capability": {
   "enum": [
    "sequence.stats.v1",
    "expression.pca.v1",
    "set.venn.v1",
    "structure.pdb.summary.v1",
    "enrichment.overrepresentation.v1",
    "fastq.qc.v1",
    "fastq"
   ]
  },
  "inputs": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "artifact_id",
     "role",
     "cardinality",
     "files"
    ],
    "properties": {
     "artifact_id": {
      "type": "string",
      "minLength": 1
     },
     "role": {
      "enum": [
       "fasta",
       "matrix",
       "table",
       "pdb",
       "genes",
       "associations",
       "fastq.qc.v1",
       "fastq"
      ]
     },
     "cardinality": {
      "const": "single"
     },
     "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
       "type": "object",
       "required": [
        "file_id",
        "path",
        "format",
        "compression",
        "size_bytes"
       ],
       "properties": {
        "file_id": {
         "type": "string",
         "minLength": 1
        },
        "path": {
         "type": "string",
         "minLength": 1
        },
        "role": {
         "type": [
          "string",
          "null"
         ]
        },
        "format": {
         "enum": [
          "fasta",
          "csv",
          "tsv",
          "pdb",
          "fastq"
         ]
        },
        "compression": {
         "const": "none"
        },
        "size_bytes": {
         "type": "integer",
         "minimum": 0
        },
        "modified_at": {
         "type": [
          "string",
          "null"
         ]
        },
        "sha256": {
         "type": [
          "string",
          "null"
         ],
         "pattern": "^[A-Fa-f0-9]{64}$"
        }
       },
       "additionalProperties": false
      }
     },
     "dataset_id": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "additionalProperties": false
   }
  },
  "execution": {
   "type": "object",
   "required": [
    "mode"
   ],
   "properties": {
    "mode": {
     "const": "local-cpu"
    },
    "backend": {
     "const": "python"
    }
   },
   "additionalProperties": false
  },
  "parameters": {
   "type": "object",
   "required": [
    "output_directory"
   ],
   "properties": {
    "output_directory": {
     "type": "string",
     "minLength": 1
    },
    "components": {
     "type": "integer",
     "minimum": 1
    },
    "scale_features": {
     "type": "boolean"
    },
    "include_items": {
     "type": "boolean"
    },
    "max_intersections": {
     "type": "integer",
     "minimum": 1,
     "maximum": 10000
    },
    "interpret_b_factors_as_plddt": {
     "type": "boolean"
    },
    "min_overlap": {
     "type": "integer",
     "minimum": 1,
     "default": 1
    },
    "max_terms": {
     "type": "integer",
     "minimum": 1,
     "default": 100
    },
    "include_genes": {
     "type": "boolean",
     "default": false
    }
   },
   "additionalProperties": false
  }
 },
 "additionalProperties": false
}
