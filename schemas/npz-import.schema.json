{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/bio/matrix.from-npz.v1.json",
  "title": "Linxira Bio npz matrix import result",
  "type": "object",
  "required": ["input_arrays", "matrix_array", "rows", "cols", "cell_count", "output_path", "output_bytes", "warnings"],
  "properties": {
    "input_arrays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "shape", "dtype"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
          "dtype": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "matrix_array": {"type": "string", "minLength": 1},
    "rows": {"type": "integer", "minimum": 1},
    "cols": {"type": "integer", "minimum": 1},
    "cell_count": {"type": "integer", "minimum": 1},
    "output_path": {"type": "string", "minLength": 1},
    "output_bytes": {"type": "integer", "minimum": 0},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
