{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/bio/set-upset.v1.json",
  "title": "Linxira Bio UpSet analysis result",
  "type": "object",
  "required": ["set_count", "union_size", "set_sizes", "intersection_count", "reported_intersection_count", "omitted_intersection_count", "intersections"],
  "properties": {
    "set_count": {"type": "integer", "minimum": 2, "maximum": 64},
    "union_size": {"type": "integer", "minimum": 1},
    "set_sizes": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"$ref": "#/$defs/setSize"}},
    "intersection_count": {"type": "integer", "minimum": 1},
    "reported_intersection_count": {"type": "integer", "minimum": 1},
    "omitted_intersection_count": {"type": "integer", "minimum": 0},
    "intersections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/intersection"}}
  },
  "$defs": {
    "setSize": {
      "type": "object",
      "required": ["name", "count"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "intersection": {
      "type": "object",
      "required": ["sets", "degree", "count", "items"],
      "properties": {
        "sets": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1}},
        "degree": {"type": "integer", "minimum": 1, "maximum": 64},
        "count": {"type": "integer", "minimum": 1},
        "items": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
