{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/bio/expression-heatmap.v1.json",
  "title": "Linxira Bio clustered expression heatmap result",
  "type": "object",
  "required": ["input_feature_count", "selected_feature_count", "sample_count", "scaled_rows", "minimum_value", "maximum_value", "row_labels", "column_labels", "values", "warnings"],
  "properties": {
    "input_feature_count": {"type": "integer", "minimum": 1},
    "selected_feature_count": {"type": "integer", "minimum": 1, "maximum": 200},
    "sample_count": {"type": "integer", "minimum": 1},
    "scaled_rows": {"type": "boolean"},
    "minimum_value": {"type": "number"},
    "maximum_value": {"type": "number"},
    "row_labels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "column_labels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "array", "minItems": 1, "items": {"type": "number"}}
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
