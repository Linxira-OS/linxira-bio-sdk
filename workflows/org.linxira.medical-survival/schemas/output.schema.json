{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linxira.org/schemas/workflows/medical-survival/output.v1.json",
  "type": "object",
  "required": ["schema_version", "job_id", "capability", "status", "result", "artifacts", "provenance", "diagnostics"],
  "properties": {
    "schema_version": { "const": "2" },
    "job_id": { "type": "string", "minLength": 1 },
    "capability": { "const": "medical.survival.v1" },
    "status": { "enum": ["ok", "error"] },
    "result": {
      "type": "object",
      "properties": {
        "n_observations": { "type": "integer", "minimum": 0 },
        "n_events": { "type": "integer", "minimum": 0 },
        "model_terms": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array" },
        "groups": { "type": "array" },
        "effective_parameters": { "type": "object" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "role", "kind", "path", "format", "media_type", "size_bytes", "sha256"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["cox-results", "km-summary"] },
          "kind": { "const": "table" },
          "path": { "type": "string", "minLength": 1 },
          "format": { "const": "csv" },
          "media_type": { "const": "text/csv" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "provenance": { "type": "object" },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["info", "warning", "error"] },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } }, "required": ["status"] },
      "then": {
        "properties": {
          "artifacts": { "minItems": 2, "maxItems": 2 }
        }
      }
    }
  ],
  "additionalProperties": false
}
